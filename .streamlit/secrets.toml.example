# Copia este archivo como .streamlit/secrets.toml (NUNCA lo subas al repositorio: está en .gitignore).
# Activa el botón "Ingresar con Google" para todos los roles. Sin este archivo la app funciona igual,
# solo con usuario y contraseña.
#
# Pasos en Google Cloud Console (gratis):
#   1. APIs y servicios > Pantalla de consentimiento OAuth: tipo "Externo", agrega tu correo como usuario de prueba.
#   2. Credenciales > Crear credenciales > ID de cliente OAuth > Aplicación web.
#   3. URI de redireccionamiento autorizado: http://localhost:8501/oauth2callback
#   4. Copia el ID y el secreto aquí abajo.
# El correo de Google debe estar registrado en la cuenta del usuario (Personal y turnos > Usuarios) o, para
# pacientes, ser el correo con el que crearon su cuenta. Nadie entra solo por tener cuenta de Google.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "cambia-esto-por-un-texto-largo-y-aleatorio"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
