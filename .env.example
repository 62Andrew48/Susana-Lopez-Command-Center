# Copia este archivo como .env (nunca lo subas al repositorio)

# Proveedor LLM: openai | anthropic | ollama | none  (none = solo Plan B, sin costo ni red)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Modelo local (privacidad total): ollama pull sqlcoder
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=sqlcoder
LLM_NARRATIVE=true

# Fecha que el sistema considera "hoy" (vacío = última fecha de ingreso de los datos)
REFERENCE_DATE=

# Umbrales de alertas
OCCUPANCY_WARNING_PCT=85
OCCUPANCY_CRITICAL_PCT=95
STOCK_CRITICAL_DAYS=5
DEMAND_SPIKE_PCT=20
WAIT_TARGET_TRIAGE2_MIN=30

# Microservicios predictivos (python microservicios/run_services.py). Solo local por defecto.
URGENCIAS_URL=http://127.0.0.1:5001
QUIROFANOS_URL=http://127.0.0.1:5002
FARMACIA_URL=http://127.0.0.1:5003
CONSULTAS_URL=http://127.0.0.1:5004
ML_TIMEOUT_SECONDS=2
